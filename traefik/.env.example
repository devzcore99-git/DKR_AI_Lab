# Traefik — environment
# Copy to `.env` and fill in real values:  cp .env.example .env

# Cloudflare API token used for the ACME DNS-01 challenge.
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone / DNS / Edit  +  Zone / Zone / Read
# scoped to the zone that hosts the *.ham51.com records.
CF_DNS_API_TOKEN=cloudflare-dns-api-token-here
