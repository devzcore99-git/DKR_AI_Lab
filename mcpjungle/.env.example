# MCPJungle — environment
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# Compose `include:` reads this directory's `.env` for the ${VAR} substitutions in
# compose.yml, so this file must live beside compose.yml — the project-root `.env`
# is NOT consulted for this service.

# ---- Required ----
# Brave Search API key. Free tier at https://api-dashboard.search.brave.com/
# Bring-up fails loudly if this is unset.
BRAVE_API_KEY=brave-search-api-key-here

# ---- Optional: gateway ----
# The `-stdio` tag ships uvx + python3, needed to spawn stdio MCP servers such as
# `fetch`. Plain `latest` cannot run them.
# MCPJUNGLE_IMAGE_TAG=latest-stdio

# `development` (no auth) or `enterprise` (API tokens, access control).
# SERVER_MODE=development

# OpenTelemetry export. Nothing collects it in this stack.
# OTEL_ENABLED=false

# Seconds to wait for an MCP server to answer `initialize` during registration.
# MCP_SERVER_INIT_REQ_TIMEOUT_SEC=10

# The gateway publishes no host port — Traefik fronts it at
# https://mcp.ham51.com, and the CLI runs inside the container
# (`docker compose exec mcpjungle /mcpjungle ...`). HOST_PORT is no longer read
# by compose.yml; re-add a `ports:` block there if you want one, knowing it
# bypasses TLS on an unauthenticated development-mode gateway.

# ---- Optional: bundled MCP servers ----
# BRAVE_MCP_LOG_LEVEL=info

# Minimum documentation tokens context7's `get-library-docs` returns.
# CONTEXT7_MIN_TOKENS=10000

# Playwright MCP image. Microsoft's official build at mcr.microsoft.com, which
# ships headless Chromium only. Pinned to v0.0.79 in compose.yml — this override
# exists to move it, and `latest` puts you back on a moving target that can swap
# the MCP tool surface and the bundled Chromium on any pull.
# Tags: https://mcr.microsoft.com/v2/playwright/mcp/tags/list
# PLAYWRIGHT_MCP_IMAGE_TAG=v0.0.79

# Only used if the commented-out `ports:` blocks in compose.yml are enabled.
# These are unauthenticated MCP endpoints; publishing one puts it on the LAN
# with no TLS and no auth. For debugging, prefer `docker compose exec`.
# BRAVE_HOST_PORT=9011
# CONTEXT7_HOST_PORT=9002
# PLAYWRIGHT_HOST_PORT=9003
# Publishing playwright also needs its host:port added to --allowed-hosts in
# compose.yml, or it answers 403 before the request reaches MCP.
