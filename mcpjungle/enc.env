# MCPJungle — environment
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# Compose `include:` reads this directory's `.env` for the ${VAR} substitutions in
# compose.yml, so this file must live beside compose.yml — the project-root `.env`
# is NOT consulted for this service.
#
# ---- Required ----
# Brave Search API key. Free tier at https://api-dashboard.search.brave.com/
# Bring-up fails loudly if this is unset.
BRAVE_API_KEY=ENC[AES256_GCM,data:D23YnGugQd9175c/9mD9I/Rciu1zlJ1IOo1Tvl1Pdg==,iv:sRWmaL48kINWCadIvR8kgvxRPypLrIfGFuUd+t0c3WI=,tag:mzwBcDhNzuIwh9sg/UUK4Q==,type:str]
#
# ---- Optional: gateway ----
# The `-stdio` tag ships uvx + python3, needed to spawn stdio MCP servers such as
# `fetch`. Plain `latest` cannot run them.
# MCPJUNGLE_IMAGE_TAG=latest-stdio
#
# `development` (no auth) or `enterprise` (API tokens, access control).
# SERVER_MODE=development
#
# OpenTelemetry export. Nothing collects it in this stack.
# OTEL_ENABLED=false
#
# Seconds to wait for an MCP server to answer `initialize` during registration.
# MCP_SERVER_INIT_REQ_TIMEOUT_SEC=10
#
# Host port for the gateway API and the `mcpjungle` CLI. Traefik also fronts it
# at https://mcp.ham51.com.
# HOST_PORT=8080
#
# ---- Optional: bundled MCP servers ----
# BRAVE_MCP_LOG_LEVEL=info
#
# Minimum documentation tokens context7's `get-library-docs` returns.
# CONTEXT7_MIN_TOKENS=10000
#
# Only used if the commented-out `ports:` blocks in compose.yml are enabled.
# Do not use 9001 for Brave — SearXNG already publishes that host port.
# BRAVE_HOST_PORT=9011
# CONTEXT7_HOST_PORT=9002
