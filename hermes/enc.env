# hermes/.env — copy to .env (gitignored) and fill in.
#
# Read by `env_file:` in hermes/compose.yml, so these land in the container's
# environment. Distinct from hermes-data/.env, which the agent reads for its
# own provider credentials once it is running.
#
# ── Dashboard login (required) ────────────────────────────────────────
# The dashboard binds 0.0.0.0 inside the container so Traefik can reach it.
# Any non-loopback bind engages the auth gate and the server fails closed
# without a provider, so these are not optional: leave them empty and the
# container runs but hermes.ham51.com never answers.
#
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=ENC[AES256_GCM,data:Lvu084c=,iv:fm5o60D9N6X3EtvFW8psnhDyhpMgWM/Aj+JZZu6OWzg=,tag:/74mMSSSQaWVJleqQKdrYw==,type:str]
#
# scrypt hash, NOT the plaintext. Generate with (password is not echoed and
# does not land in shell history):
#
#  docker run --rm -it --entrypoint /opt/hermes/.venv/bin/python \
#    nousresearch/hermes-agent:latest -c \
#    'import getpass; from plugins.dashboard_auth.basic import hash_password; print(hash_password(getpass.getpass(\"password: \")))'
#
# Paste the resulting scrypt$... string here.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=ENC[AES256_GCM,data:KciPPOcL+POwTQFfbrcyVdEPlI2PEilx8KFkqIVMG1K0wPiPgTMWbaUu51ce15qotUeY6gvcXyOKVI4mjjI1DSv8Xa/cyDOdPQmB6Lu5NhiUlvghHiIfpw==,iv:JMQqGh1hsYfa97x/RPbOvZof7keQe1Mkhe3nkc3qwgk=,tag:xdQy1YSFVBVR4cQm3k42Bw==,type:str]
#
# HMAC key signing dashboard session tokens. Without it a random key is
# generated per process, so every container restart logs you out.
# Generate with:  openssl rand -base64 48
HERMES_DASHBOARD_BASIC_AUTH_SECRET=ENC[AES256_GCM,data:wU6NQNTAqRpATP/PRZaEJmgr+AXUx5Q/FA43stSTrJgOrILKkJqmvqvS/TwUS3ugG8IySV0MzVcwc+3rcaOV7g==,iv:fyTFHeA+OOTXoUdV2Q9LlNvUFKtv3l8v6MFL7nxuzkI=,tag:Lu+NGCoNvkkd2UG8RkiUWg==,type:str]
#
# ── Inference endpoint ────────────────────────────────────────────────
# The model itself is chosen in hermes-data/config.yaml (model.default +
# custom_providers); these are the fallback/plugin-facing copies of the same
# endpoint. Keep the two in step — pointing only OPENAI_BASE_URL somewhere new
# changes nothing about which model the agent talks to.
#
# llm-coder-mid.ham51.com is llama.cpp on 192.168.12.193 (the DKR_AI_Lab2 host),
# serving model id `coder-mid`. It is TLS-only and requires the key below, so
# the scheme must be https — this Traefik binds 443 alone, and so does that one.
#
# The in-lab alternative is `http://llama-gpt-oss:9010/v1`, which only exists
# when COMPOSE_PROFILES (root .env) names cuda or vulkan.
#
OPENAI_BASE_URL=https://llm-coder-mid.ham51.com/v1
# Namespaced on purpose — open-webui/enc.env carries an OPENAI_API_KEY too,
# with a different value. hermes/compose.yml maps this back to the plain
# name inside the container, which is what the agent plugins read.
HERMES_OPENAI_API_KEY=ENC[AES256_GCM,data:hBoy40s3I/TTPGWLan+W7nuAU5CXhmL/LskyL2JyGmRJMMg=,iv:4IPsQfYImR7yZ3trpc+PIGwNLqnxHrVkg05v4PmFDf0=,tag:8BFnsrvY4W0HijYEQ2MMeA==,type:str]
#
# The same key a second time, under the name hermes-data/config.yaml resolves
# it by: the custom_providers entry there sets `key_env:` to this variable.
# Hermes reads its model and provider from that file, never from
# OPENAI_BASE_URL, so this copy is the one the agent actually authenticates with.
HERMES_CUSTOM_LLM_CODER_MID_HAM51_COM_API_KEY=ENC[AES256_GCM,data:i1ZhXTBAzrukpc8Te4mwRd6qgqB6/wg0AziQGlaUB77tFME=,iv:EA1b6iDAQSwvuXRFW/k2nYn9Om1bSQHPIStVBfYPpyI=,tag:9L1rmWUSxf+D9e/+9kemDQ==,type:str]
# SEARXNG_URL=http://searxng:8080
#
# ── Agent integrations (optional) ─────────────────────────────────────
# BRAVE_SEARCH_API_KEY is keyed separately from open-webui/.env and
# mcpjungle/.env — three files, three copies, same vendor.
#
# Third copy of the SAME Brave key: open-webui/enc.env and mcpjungle/enc.env
# (as BRAVE_API_KEY) hold this identical value. Nothing keeps the three in
# step, so rotating means editing all three.
HERMES_BRAVE_SEARCH_API_KEY=ENC[AES256_GCM,data:CmGVCq3VK5yWtKwHeBzy5quhtEDrh/F3LoBJcr20SA==,iv:Zsn5qCkzn9QLFkVmEkRpSQ+/dGME5ReF0H2t5TlVGlk=,tag:+c/0T4XI4AyE4lQIYoAFXQ==,type:str]
SLACK_BOT_TOKEN=ENC[AES256_GCM,data:D7fDRwUAr1MVlPcU0CR7W8P7h+vFZbyyRzAhE/IeC+TyLxNKhQw8MeWJNg2zuGESwieOOoHSDhPpui8=,iv:C07pYu8xTGsj5a7260PiAS9gRb/18sspb+uIgDDOWZI=,tag:6hwNzlfDoSNDXTblWms1Xw==,type:str]
SLACK_APP_TOKEN=ENC[AES256_GCM,data:LXcqoPslHv7dkxAq1bdi1xl/+Sa7t1FHjSsABeCdrzgZBOXNLqryzcNNjwuga46SOz4GW5NXurjthEn5rIMOiiqbXEvO+BqcQFbTsAtsIR+XpRJLoE7wf+8zAKzI0DqLxlg=,iv:BBVXtnytGjhv9BA/VrXJ0aGgN+Gj4KyZk5PiSuVIT+U=,tag:J/LIWmPYalDyL9WFGMI9fQ==,type:str]
SLACK_ALLOWED_USERS=
SLACK_HOME_CHANNEL=
