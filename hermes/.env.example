# hermes/.env — copy to .env (gitignored) and fill in.
#
# Read by `env_file:` in hermes/compose.yml, so these land in the container's
# environment. Distinct from hermes-data/.env, which the agent reads for its
# own provider credentials once it is running.

# ── Dashboard login (required) ────────────────────────────────────────
# The dashboard binds 0.0.0.0 inside the container so Traefik can reach it.
# Any non-loopback bind engages the auth gate and the server fails closed
# without a provider, so these are not optional: leave them empty and the
# container runs but hermes.ham51.com never answers.

HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin

# scrypt hash, NOT the plaintext. Generate with (password is not echoed and
# does not land in shell history):
#
#   docker run --rm -it --entrypoint /opt/hermes/.venv/bin/python \
#     nousresearch/hermes-agent:latest -c \
#     'import getpass; from plugins.dashboard_auth.basic import hash_password; print(hash_password(getpass.getpass("password: ")))'
#
# Paste the resulting scrypt$... string here.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=

# HMAC key signing dashboard session tokens. Without it a random key is
# generated per process, so every container restart logs you out.
# Generate with:  openssl rand -base64 48
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# ── Inference endpoint (required in practice) ─────────────────────────
# Which MODEL the agent uses is not set here — it is `model.default` in
# hermes-data/config.yaml, seeded from hermes/config.yaml.example. These are
# the endpoint's plugin-facing copies. Set them and leave config.yaml alone and
# the agent still talks to whatever the image defaults to.
#
# The lab's own default is llm-coder-mid.ham51.com (llama.cpp on the
# DKR_AI_Lab2 host, model id `coder-mid`). https, not http: that Traefik binds
# 443 alone, exactly like this one, so the plaintext port is not open.
#
# The key is namespaced by service: open-webui/.env carries its own
# OPENAI_API_KEY for a different backend, and per-directory .env files are all
# that keep the two apart. compose.yml maps this back to the plain name inside
# the container.
#
# OPENAI_BASE_URL=https://llm-coder-mid.ham51.com/v1
# HERMES_OPENAI_API_KEY=

# The same key under the name config.yaml's `key_env:` points at. Hermes reads
# it from the process environment, so it belongs here rather than in
# hermes-data/.env. Rename both together if you point at a different endpoint.
# HERMES_CUSTOM_LLM_CODER_MID_HAM51_COM_API_KEY=

# The in-lab alternative, which needs no key but only exists while
# COMPOSE_PROFILES (root .env) names cuda or vulkan — the alias is the same for
# both profiles. `llama.cpp/detect-gpu.sh` is what writes that variable.
#
# OPENAI_BASE_URL=http://llama-gpt-oss:9010/v1
# SEARXNG_URL=http://searxng:8080

# ── Agent integrations (optional) ─────────────────────────────────────
# BRAVE_SEARCH_API_KEY is keyed separately from open-webui/.env and
# mcpjungle/.env — three files, three copies, same vendor.
#
# HERMES_BRAVE_SEARCH_API_KEY=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ALLOWED_USERS=
# SLACK_HOME_CHANNEL=
