# SearXNG — environment
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# The stack currently runs SearXNG with an empty .env (all configuration lives
# in core-config/settings.yml). The file must still exist because compose.yml
# references it via `env_file:`. Uncomment below if you prefer env-based config.
#
# Public base URL Traefik serves this instance on.
# SEARXNG_BASE_URL=https://search.ham51.com/

# Overrides server.secret_key in settings.yml. Generate with:
#   openssl rand -hex 16
# SEARXNG_SECRET=generate-a-random-secret
