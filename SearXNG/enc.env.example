# SearXNG — configuration
# Not copied anywhere. This documents the plaintext contents of SearXNG/enc.env,
# which is committed age-encrypted and edited in place:
#
#   sops SearXNG/enc.env       decrypts into $EDITOR, re-encrypts on save
#
# There is no SearXNG/.env. `./runit.sh` decrypts enc.env straight into its own
# environment and execs `docker compose` there, so every value below reaches the
# container through `${VAR}` interpolation in compose.yml — and only if it is
# named there. Adding a variable here and to enc.env is not enough on its own.
#
#
# Both variables below are REQUIRED — compose.yml declares them with `:?`, so a
# missing one stops the whole project at parse time. They used to be optional,
# back when core-config/settings.yml carried this configuration on its own; that
# file is gitignored, so a fresh clone has neither unless these are set.
#
# Public base URL Traefik serves this instance on.
SEARXNG_BASE_URL=https://search.ham51.com/

# Overrides server.secret_key in settings.yml. Generate with:
#   openssl rand -hex 16
SEARXNG_SECRET=generate-a-random-secret
