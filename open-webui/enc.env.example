# Open WebUI — configuration
# Not copied anywhere. This documents the plaintext contents of open-webui/enc.env,
# which is committed age-encrypted and edited in place:
#
#   sops open-webui/enc.env       decrypts into $EDITOR, re-encrypts on save
#
# There is no open-webui/.env. `./runit.sh` decrypts enc.env straight into its own
# environment and execs `docker compose` there, so every value below reaches the
# container through `${VAR}` interpolation in compose.yml — and only if it is
# named there. Adding a variable here and to enc.env is not enough on its own.
#
#
# KEY=value syntax, one per line. Do NOT use YAML "KEY: value" style — those
# lines do not parse and the value never reaches the container.
#
# Quoting is significant. A value is passed through literally, but surrounding
# quotes are stripped, and a value containing '$' MUST be quoted: unquoted, the
# dotenv parser expands its $-segments as variables and silently mangles it.
#
# This file is for secrets and host-specific values. Non-secret configuration
# that should be version-controlled lives in `compose.yml` instead — notably
# TOOL_SERVER_CONNECTIONS, which pre-registers the MCPJungle tool groups. Do
# not set that variable here as well; compose.yml sets it directly.
#
# Full variable reference: https://docs.openwebui.com/getting-started/env-configuration

# ---- Upstream OpenAI-compatible model backend ----
# Point at whichever inference server you are running:
#   coder-mid, DKR_AI_Lab2 host : https://llm-coder-mid.ham51.com/v1  (current)
#   LM Studio on the host       : http://host.docker.internal:12111/v1
#
# llm-coder-mid is a separate machine reached over the LAN, not over AI-LAB, and
# it is https-only — that host's Traefik binds 443 alone, so http:// hits a
# closed port. It also requires a key and answers 401 to any other, which is a
# clean way to check before restarting anything:
#
#   curl -H "Authorization: Bearer $KEY" https://llm-coder-mid.ham51.com/v1/models
#
# SEEDS ONCE. Open WebUI treats this and OPENAI_API_KEY as PersistentConfig: they
# populate webui.db only while that row is absent, and are ignored on every later
# start. On an install with an existing volume, changing this and restarting does
# nothing at all — change it in Admin Settings → Connections, or clear the row.
OPENAI_API_BASE_URL=https://llm-coder-mid.ham51.com/v1

# NOTE THE PREFIX. runit.sh loads every service's enc.env into one flat
# environment, so a bare OPENAI_API_KEY here would be first-come-first-served
# the moment another service wants one. compose.yml maps this to the plain
# OPENAI_API_KEY the container reads; leave it unset and the project fails to
# parse rather than starting keyless.
OPENWEBUI_OPENAI_API_KEY=sk-replace-me

# ---- Auth ----
# WEBUI_AUTH=False disables login entirely. Only safe on a trusted network —
# set it to True before exposing Open WebUI to the internet via Traefik.
WEBUI_AUTH=False

# Signing key for sessions/JWTs. Generate with:  openssl rand -base64 32
# Changing this invalidates all existing sessions.
WEBUI_SECRET_KEY=generate-a-random-base64-secret

# ---- Web search ----
# Pick ONE engine below.

# Option A: Brave Search (hosted, needs an API key)
# Key from: https://api-dashboard.search.brave.com/
ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=brave
# Namespaced for the same reason. mcpjungle/enc.env holds a copy of this same
# key under the name BRAVE_API_KEY, and nothing keeps the two in step —
# rotating the Brave key means editing both.
OPENWEBUI_BRAVE_SEARCH_API_KEY=brave-search-api-key-here
WEB_SEARCH_RESULT_COUNT=5

# Option B: SearXNG (self-hosted, no API key — see ../SearXNG)
# ENABLE_WEB_SEARCH=True
# WEB_SEARCH_ENGINE=searxng
# SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
# WEB_SEARCH_RESULT_COUNT=5
