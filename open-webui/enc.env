OPENAI_API_BASE_URL=http://host.docker.internal:12111/v1
# Namespaced on purpose. hermes/enc.env also carries an OPENAI_API_KEY,
# with a DIFFERENT value — the two are isolated today only because
# `include:` gives each service file its own directory .env. Anything that
# flattens them into one environment silently keeps one value and loses the
# other. open-webui/compose.yml maps this back to OPENAI_API_KEY for the
# container; rename in one place and the mapping fails loudly.
OPENWEBUI_OPENAI_API_KEY=ENC[AES256_GCM,data:kSH4xjKlF2+hBE+w0F8kbZH4HoQdzbDo56B1xxQeU9ORV1g=,iv:EoyndtoBznmt7s0sqKhzW7kMTjRYnWr4cw9Ssk6RS+o=,tag:m0l0TIVWCCe9iSVyL693LA==,type:str]
WEBUI_AUTH=False
WEBUI_SECRET_KEY=ENC[AES256_GCM,data:ln7A46Iozu+46Q+8IBLB4XN+HskLKrJciK/32LHnlXeusuuMBDI5L6vSJkI=,iv:kxu6EIp7NeQTC6PrIKTfOI/CS2IBIextoh9RLC/K2qU=,tag:rszwXh4gYtk5H61hVbdZQQ==,type:str]
#SearXNG
#ENABLE_WEB_SEARCH="True"
#WEB_SEARCH_ENGINE="searxng"
#SEARXNG_QUERY_URL="http://searxng:9001/search?q=<query>"
#WEB_SEARCH_RESULT_COUNT="5"
#Brave COnfig
ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=brave
# Namespaced for the same reason, though this one is not a live conflict: the
# copies in hermes/enc.env and mcpjungle/enc.env (as BRAVE_API_KEY) hold the
# SAME key today. Three copies of one value that nothing keeps in step — the
# prefix is what lets them be rotated apart later without a name clash.
OPENWEBUI_BRAVE_SEARCH_API_KEY=ENC[AES256_GCM,data:6zsPpYB04ZbGLERJbcVpn/B74MIKLewwEr8N/K8TfA==,iv:o7GejPx1T7QKfc7JSBPJsGNI1QS99tbN3d0a7A4vcnw=,tag:/FF7OnFLNtcf2JEqnSP0jQ==,type:str]
WEB_SEARCH_RESULT_COUNT=5
