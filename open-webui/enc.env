OPENAI_API_BASE_URL=https://llm-coder-mid.ham51.com/v1
# Namespaced on purpose. runit.sh loads every service's enc.env into one flat
# environment, so a bare OPENAI_API_KEY here would be first-come-first-served
# the moment any other service wants one. open-webui/compose.yml maps this back
# to the plain OPENAI_API_KEY the container reads.
OPENWEBUI_OPENAI_API_KEY=ENC[AES256_GCM,data:kO7FSwpCsInlEChBtkFdPka06NoMmd2LFgRvDTUdFrfh+Rk=,iv:YikmvBl5s59gSjSSRI+Ie/pRIhcgRdxrf58yPffgpdo=,tag:Ai0gBl6sgi2YK53NVZI7WA==,type:str]
WEBUI_AUTH=False
WEBUI_SECRET_KEY=ENC[AES256_GCM,data:ln7A46Iozu+46Q+8IBLB4XN+HskLKrJciK/32LHnlXeusuuMBDI5L6vSJkI=,iv:kxu6EIp7NeQTC6PrIKTfOI/CS2IBIextoh9RLC/K2qU=,tag:rszwXh4gYtk5H61hVbdZQQ==,type:str]
#SearXNG
#ENABLE_WEB_SEARCH="True"
#WEB_SEARCH_ENGINE="searxng"
#SEARXNG_QUERY_URL="http://searxng:9001/search?q=<query>"
#WEB_SEARCH_RESULT_COUNT="5"
#Brave COnfig
ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=brave
# Namespaced for the same reason. mcpjungle/enc.env holds the SAME key under
# the name BRAVE_API_KEY, and nothing keeps the two in step — rotating the
# Brave key means editing both files.
OPENWEBUI_BRAVE_SEARCH_API_KEY=ENC[AES256_GCM,data:6zsPpYB04ZbGLERJbcVpn/B74MIKLewwEr8N/K8TfA==,iv:o7GejPx1T7QKfc7JSBPJsGNI1QS99tbN3d0a7A4vcnw=,tag:/FF7OnFLNtcf2JEqnSP0jQ==,type:str]
WEB_SEARCH_RESULT_COUNT=5
